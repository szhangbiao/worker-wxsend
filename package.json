{
	"name": "worker-wxsend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler pages dev --proxy 5173 --port 8787",
		"dev:frontend": "vite",
		"dev:api": "wrangler pages dev dist --port 0",
		"dev:fullstack": "concurrently \"npm run dev:frontend\" \"wrangler pages dev --proxy 5173 --port 8787\"",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"pages:deploy": "npm run build && wrangler pages deploy dist",
		"test": "vitest",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@radix-ui/react-slot": "^1.2.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "^4.12.18",
		"lucide-react": "^1.16.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.16.5",
		"@tailwindcss/postcss": "^4.3.0",
		"@types/node": "^25.8.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"autoprefixer": "^10.5.0",
		"concurrently": "^9.2.1",
		"postcss": "^8.5.14",
		"tailwindcss": "^4.3.0",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^6.0.3",
		"vite": "^8.0.13",
		"vitest": "^4.1.6",
		"wrangler": "^4.91.0"
	}
}